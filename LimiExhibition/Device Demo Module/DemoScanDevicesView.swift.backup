import SwiftUI
import Network
import Foundation

struct AnimatedSearchButton: View {
    @State private var isAnimating = false
    @State private var glowIntensity: Double = 0.3
    let iconName: String
    var body: some View {
        ZStack {
            // Main circular button with gradient background
            Circle()
                .fill(
                    LinearGradient(
                        gradient: Gradient(colors: [
                            Color(hex: "#2E2E2E"),
                            Color(hex: "#3A3A3A")
                        ]),
                        startPoint: .top,
                        endPoint: .bottom
                    )
                )
                .frame(width: 160, height: 160)
                .shadow(
                    color: Color.green.opacity(glowIntensity),
                    radius: 25,
                    x: 0,
                    y: 8
                )
                .scaleEffect(isAnimating ? 1.05 : 1.0)
                .animation(
                    Animation.easeInOut(duration: 2.0)
                        .repeatForever(autoreverses: true),
                    value: isAnimating
                )
            
            // White magnifying glass icon
            Image(systemName: iconName)
                .font(.system(size: 48, weight: .medium))
                .foregroundColor(.white)
                .scaleEffect(isAnimating ? 1.1 : 1.0)
                .animation(
                    Animation.easeInOut(duration: 1.5)
                        .repeatForever(autoreverses: true),
                    value: isAnimating
                )
            
            // Outer glow ring animation
            Circle()
                .stroke(
                    Color.green.opacity(0.4),
                    lineWidth: 2
                )
                .frame(width: 180, height: 180)
                .scaleEffect(isAnimating ? 1.2 : 1.0)
                .opacity(isAnimating ? 0.0 : 0.8)
                .animation(
                    Animation.easeOut(duration: 2.5)
                        .repeatForever(autoreverses: false),
                    value: isAnimating
                )
        }
        .onAppear {
            isAnimating = true
            // Animate glow intensity
            withAnimation(
                Animation.easeInOut(duration: 1.8)
                    .repeatForever(autoreverses: true)
            ) {
                glowIntensity = 0.8
            }
        }
    }
}
// Model to represent both BLE and Wi-Fi devices
struct BLEDevice: Identifiable, Equatable {
    let id: String
    let name: String
    let uuid: String
    let deviceType: DeviceType
    let ipAddress: String?
    let txtRecord: [String: String]? // Store TXT record data for Wi-Fi devices
    
    enum DeviceType: Equatable {
        case bluetooth
        case wifi
    }
    
    init(name: String, uuid: String, deviceType: DeviceType = .bluetooth, ipAddress: String? = nil, txtRecord: [String: String]? = nil) {
        self.name = name
        self.uuid = uuid
        self.id = uuid
        self.deviceType = deviceType
        self.ipAddress = ipAddress
        self.txtRecord = txtRecord
    }
    
    // Equatable conformance
    static func == (lhs: BLEDevice, rhs: BLEDevice) -> Bool {
        return lhs.id == rhs.id &&
               lhs.name == rhs.name &&
               lhs.uuid == rhs.uuid &&
               lhs.deviceType == rhs.deviceType &&
               lhs.ipAddress == rhs.ipAddress &&
               lhs.txtRecord == rhs.txtRecord
    }
}

// Bonjour Service Browser for Wi-Fi device discovery
class BonjourServiceBrowser: NSObject, ObservableObject, NetServiceBrowserDelegate, NetServiceDelegate {
    static let shared = BonjourServiceBrowser()
    private let serviceBrowser = NetServiceBrowser()
    private var isBrowsing = false
    @Published var discoveredWiFiDevices: [BLEDevice] = []
    private var resolvingServices: [NetService] = []
    private var deviceLastSeen: [String: Date] = [:] // Track when devices were last seen
    private var monitoringTimer: Timer?
    private let deviceTimeout: TimeInterval = 30.0 // Remove devices not seen for 30 seconds
    // Track active NetService references and re-resolution state
    private var servicesByName: [String: NetService] = [:]
    private var currentlyResolving: Set<String> = []
    private var pendingRemoval: Set<String> = [] // Grace step before removal
    
    private override init() {
        super.init()
        serviceBrowser.delegate = self
    }
    
    func startBrowsing() {
        // Avoid starting multiple concurrent searches
        if isBrowsing { return }
        isBrowsing = true
        print("🔍 Starting Bonjour service discovery for _Limi1Ch._udp.")
        discoveredWiFiDevices.removeAll()
        deviceLastSeen.removeAll()
        servicesByName.removeAll()
        currentlyResolving.removeAll()
        pendingRemoval.removeAll()
        
        // Add a small delay to ensure network stack is ready
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
            self.serviceBrowser.searchForServices(ofType: "_Limi1Ch._udp.", inDomain: "local.")
        }
        
        // Start continuous monitoring timer
        startDeviceMonitoring()
    }
    
    func stopBrowsing() {
        print("🔴 Stopping Bonjour service discovery")
        serviceBrowser.stop()
        resolvingServices.removeAll()
        stopDeviceMonitoring()
        isBrowsing = false
    }
    
    // MARK: - NetServiceBrowserDelegate
    func netServiceBrowser(_ browser: NetServiceBrowser, didFind service: NetService, moreComing: Bool) {
        print("🔍 Found Bonjour service: \(service.name) of type \(service.type)")
        // Hold reference and mark last-seen
        servicesByName[service.name] = service
        DispatchQueue.main.async { self.deviceLastSeen[service.name] = Date() }

        service.delegate = self
        resolvingServices.append(service)
        service.resolve(withTimeout: 10.0)
        // Monitor TXT updates to refresh last-seen
        service.startMonitoring()
    }
    
    func netServiceBrowser(_ browser: NetServiceBrowser, didRemove service: NetService, moreComing: Bool) {
        print("🔴 Bonjour service removed: \(service.name)")
        DispatchQueue.main.async {
            self.discoveredWiFiDevices.removeAll { $0.name == service.name }
            self.deviceLastSeen.removeValue(forKey: service.name)
            self.servicesByName.removeValue(forKey: service.name)
            self.currentlyResolving.remove(service.name)
            self.pendingRemoval.remove(service.name)
        }
    }
    
    func netServiceBrowser(_ browser: NetServiceBrowser, didNotSearch errorDict: [String : NSNumber]) {
        let errorCode = errorDict[NetService.errorCode]?.intValue ?? 0
        let errorDomain = errorDict[NetService.errorDomain]?.intValue ?? 0
        print("❌ Bonjour search failed - Code: \(errorCode), Domain: \(errorDomain)")
        print("❌ Full error dict: \(errorDict)")
        
        // Common error codes:
        // -72008: Network unavailable or permissions issue
        // -72004: Service not found
        switch errorCode {
        case -72008:
            print("💡 Suggestion: Check network connectivity and local network permissions")
        case -72004:
            print("💡 Suggestion: No services of type '_Limi1Ch._udp.' found on network")
        default:
            print("💡 Suggestion: Check Info.plist NSBonjourServices configuration")
        }
    }
    
    // MARK: - NetServiceDelegate
    func netServiceDidResolveAddress(_ sender: NetService) {
        print("✅ Resolved Bonjour service: \(sender.name)")
        
        // Get addresses
        guard let addresses = sender.addresses, !addresses.isEmpty else {
            print("⚠️ No addresses found for service: \(sender.name)")
            return
        }

        // Extract IP address
        let ipAddress = self.getIPAddress(from: addresses.first!)
        print("📍 Service \(sender.name) resolved to IP: \(ipAddress ?? "unknown")")
        
        // ✅ Access TXT Record (also refresh last-seen)
        var txtRecordDict: [String: String] = [:]
        if let txtData = sender.txtRecordData(),
           let txtDict = NetService.dictionary(fromTXTRecord: txtData) as? [String: Data] {
            print("📦 TXT Record for \(sender.name):")
            for (key, value) in txtDict {
                let valueString = String(data: value, encoding: .utf8) ?? "N/A"
                txtRecordDict[key] = valueString
                print("  \(key): \(valueString)")
            }
        } else {
            print("⚠️ No TXT record found for service: \(sender.name)")
        }
        
        // Add discovered device to your list
        let wifiDevice = BLEDevice(
            name: sender.name,
            uuid: sender.name,
            deviceType: .wifi,
            ipAddress: ipAddress,
            txtRecord: txtRecordDict.isEmpty ? nil : txtRecordDict
        )

        DispatchQueue.main.async {
            // Update last seen timestamp for this device
            self.deviceLastSeen[sender.name] = Date()
            // Cancel any pending removal since we heard from it
            self.pendingRemoval.remove(sender.name)
            
            if !self.discoveredWiFiDevices.contains(where: { $0.name == sender.name }) {
                self.discoveredWiFiDevices.append(wifiDevice)
                print("✅ Added Wi-Fi device to array - Name: '\(wifiDevice.name)', Total devices: \(self.discoveredWiFiDevices.count)")
                self.objectWillChange.send()
            } else {
                print("🔄 Updated Wi-Fi device '\(sender.name)' last seen timestamp")
            }
        }
        
        resolvingServices.removeAll { $0 == sender }
        currentlyResolving.remove(sender.name)
    }

    
    func netService(_ sender: NetService, didNotResolve errorDict: [String : NSNumber]) {
        print("❌ Failed to resolve service \(sender.name): \(errorDict)")
        resolvingServices.removeAll { $0 == sender }
        currentlyResolving.remove(sender.name)
    }

    // Refresh last-seen when TXT record updates
    func netService(_ sender: NetService, didUpdateTXTRecord data: Data) {
        DispatchQueue.main.async {
            self.deviceLastSeen[sender.name] = Date()
            self.pendingRemoval.remove(sender.name)
        }
    }
    
    private func getIPAddress(from addressData: Data) -> String? {
        return addressData.withUnsafeBytes { bytes in
            let sockaddr = bytes.bindMemory(to: sockaddr.self).baseAddress!
            
            switch Int32(sockaddr.pointee.sa_family) {
            case AF_INET:
                let addr = bytes.bindMemory(to: sockaddr_in.self).baseAddress!
                return String(cString: inet_ntoa(addr.pointee.sin_addr))
            case AF_INET6:
                let addr = bytes.bindMemory(to: sockaddr_in6.self).baseAddress!
                var buffer = [CChar](repeating: 0, count: Int(INET6_ADDRSTRLEN))
                // Make a local copy to obtain a stable pointer for inet_ntop
                let sin6 = addr.pointee.sin6_addr
                let result = withUnsafePointer(to: sin6) { ptr -> UnsafePointer<CChar>? in
                    inet_ntop(AF_INET6, ptr, &buffer, socklen_t(INET6_ADDRSTRLEN))
                }
                if result != nil {
                    return String(cString: buffer)
                }
                return nil
            default:
                return nil
            }
        }
    }
    
    // MARK: - Device Monitoring
    private func startDeviceMonitoring() {
        stopDeviceMonitoring() // Stop any existing timer
        
        monitoringTimer = Timer.scheduledTimer(withTimeInterval: 5.0, repeats: true) { _ in
            self.checkDeviceAvailability()
        }
        print("🔄 Started continuous device monitoring (checking every 5 seconds)")
    }
    
    private func stopDeviceMonitoring() {
        monitoringTimer?.invalidate()
        monitoringTimer = nil
        print("⏹️ Stopped device monitoring")
    }
    
    private func checkDeviceAvailability() {
        let now = Date()
        var devicesToRemove: [String] = []
        
        // Check which devices haven't been seen recently
        for (deviceName, lastSeen) in deviceLastSeen {
            let timeSinceLastSeen = now.timeIntervalSince(lastSeen)
            guard timeSinceLastSeen > deviceTimeout else { continue }

            // Grace flow: try to re-resolve once before removal
            if !pendingRemoval.contains(deviceName) {
                if let service = servicesByName[deviceName], !currentlyResolving.contains(deviceName) {
                    currentlyResolving.insert(deviceName)
                    print("🔁 Re-resolving '\(deviceName)' before removal (last seen \(Int(timeSinceLastSeen))s ago)")
                    service.resolve(withTimeout: 3.0)
                }
                pendingRemoval.insert(deviceName)
                continue
            }

            // If already pending and still timed-out, mark for removal
            devicesToRemove.append(deviceName)
        }
        
        // Remove timed-out devices
        if !devicesToRemove.isEmpty {
            DispatchQueue.main.async {
                for deviceName in devicesToRemove {
                    self.discoveredWiFiDevices.removeAll { $0.name == deviceName }
                    self.deviceLastSeen.removeValue(forKey: deviceName)
                    self.servicesByName.removeValue(forKey: deviceName)
                    self.currentlyResolving.remove(deviceName)
                    self.pendingRemoval.remove(deviceName)
                }
                print("🧹 Removed \(devicesToRemove.count) inactive devices. Active devices: \(self.discoveredWiFiDevices.count)")
                self.objectWillChange.send()
            }
        }
    }
}

struct DevicesButton: View {
    let deviceName: String?
    let searchDeviceUUID: String?
    let onConnect: (String, String) -> Void
    let isConnected: Bool
    let deviceType: BLEDevice.DeviceType
    let ipAddress: String?
    var body: some View {
        HStack(spacing: 16) {

            VStack{
                // Device icon with rounded background - different for BLE vs Wi-Fi
                ZStack {
                    RoundedRectangle(cornerRadius: 12)
                        .fill(deviceType == .bluetooth ? Color(hex: "#111214") : Color(hex: "#1A1A2E"))
                        .frame(width: 60, height: 60)
                    
                    VStack(spacing: 2) {
                        Image(systemName: deviceType == .bluetooth ? "lamp.table.fill" : "wifi")
                            .font(.system(size: deviceType == .bluetooth ? 24 : 20, weight: .medium))
                            .foregroundColor(deviceType == .bluetooth ? Color.emerald : Color.blue)
                        
                        // Small indicator for device type
                        Text(deviceType == .bluetooth ? "BLE" : "WiFi")
                            .font(.system(size: 8, weight: .bold))
                            .foregroundColor(deviceType == .bluetooth ? Color.emerald : Color.blue)
                    }
                }
                Spacer()
            }
            VStack(alignment: .leading, spacing: 8) {
                // Device type label
                HStack {
                    Text(deviceName ?? "Unknown Device")
                        .font(.custom("Poppins-Medium", size: 12))
                        .foregroundColor(.white)
                        .padding(.horizontal, 8)
                        .padding(.vertical, 4)
                        .background(Color.black)
                        .cornerRadius(4)
                    
                    Spacer()
                }
                
                // Device ID or IP Address
                VStack(alignment: .leading, spacing: 4) {
                    Text(searchDeviceUUID ?? "XTP-1245")
                        .font(.custom("Poppins-Bold", size: 20))
                        .foregroundColor(.white)
                        .lineSpacing(0)
                        .kerning(0)
                    
                    // Show IP address for Wi-Fi devices
                    if deviceType == .wifi, let ip = ipAddress {
                        Text("IP: \(ip)")
                            .font(.custom("Poppins-Regular", size: 12))
                            .foregroundColor(Color.blue.opacity(0.8))
                    }
                }
                if deviceType == .wifi, let ip = ipAddress {
                    // Connect button
                    Button(action: {
                        if let name = deviceName, let id = searchDeviceUUID {
                            onConnect(name, id)
                        }
                    }) {
                        Text("Connected")
                            .font(.custom("Poppins-SemiBold", size: 16))
                            .foregroundColor(Color.charlestonGreen)
                            .frame(maxWidth: .infinity)
                            .padding(.vertical, 12)
                            .background( Color.emerald)
                            .cornerRadius(8)
                    }
                } else {
                    // Connect button
                    Button(action: {
                        if let name = deviceName, let id = searchDeviceUUID {
                            onConnect(name, id)
                        }
                    }) {
                        Text(isConnected ? "Connected" : "Connect")
                            .font(.custom("Poppins-SemiBold", size: 16))
                            .foregroundColor(Color.charlestonGreen)
                            .frame(maxWidth: .infinity)
                            .padding(.vertical, 12)
                            .background( Color.emerald)
                            .cornerRadius(8)
                    }
                }
            }
            
            Spacer()
        }
        .padding(12)
        .background(
            RoundedRectangle(cornerRadius: 12)
                .fill(Color(hex: "#24262B"))
        )
        .overlay(
            RoundedRectangle(cornerRadius: 12)
                .stroke(Color(hex: "#4A4A4A"), lineWidth: 1)
        )
    }
}
struct DemoScanDevicesView: View {
    // back to Onboarding last page
    var onBack: (() -> Void)? = nil
    @Environment(\.dismiss) private var dismiss
    @State private var scannedDevices: [BLEDevice] = []
    private let allowedNames: Set<String> = ["1 CH-HUB", "Mini Controller"]
    @ObservedObject private var ble = BluetoothManager.shared
    @ObservedObject private var bonjourBrowser = BonjourServiceBrowser.shared
    @State private var showAddWifi: Bool = false
    @State private var selectedName: String? = nil
    @State private var selectedId: String? = nil
    @State private var selectedChannelMac: String = ""
    @State private var isShowingPWM2LEDSheet: Bool = false
    
    @State private var isShowingRGBDataSheet: Bool = false
    @State private var ssidNameArray: [String] = []

    private var shouldShowContinue: Bool {
        let hasAllowedBonjour = bonjourBrowser.discoveredWiFiDevices.contains { allowedNames.contains($0.name) }
        let hasAllowedConnectedBLE = ble.connectedDevices.contains { (_, tuple) in
            tuple.peripheral.state == .connected && allowedNames.contains(tuple.peripheral.name ?? "")
        }
        return hasAllowedBonjour || hasAllowedConnectedBLE
    }

    var body: some View {
        VStack {

            VStack(alignment: .center, spacing:12){
                HStack{
                    Button {
                        if let onBack {
                            onBack()
                        } else {
                            dismiss()
                        }
                    } label: {
                        Image("Solid arrow right sm")
                            .resizable()
                            .scaledToFit()
                            .frame(width: 20, height: 20)
                            .padding(12) // space inside the circle
                            .background(
                                Rectangle()
                                    .fill(Color(hex: "#24262B")) // gray background
                                    .cornerRadius(16)
                            )
                    }
                    Spacer()
                    Text("Add Device")
                        .font(.custom("Poppins-Bold", size: 30)) // font-family: Poppins; weight: 700 (Bold)
                        .multilineTextAlignment(.center)          // text-align: center
                        .lineSpacing(8)                           // 38px line height - 30px font size = 8px spacing
                        .kerning(-0.3)                            // letter-spacing: -1%
                        .foregroundColor(Color.alabaster)
                    Spacer()
                    Spacer()

                    
                }
                .padding(.horizontal, 16)
                

                Text("Scanning....")
                    .font(.custom("Poppins-Medium", size: 20))  // 500 weight = Medium
                    .multilineTextAlignment(.center)            // text-align: center
                    .foregroundColor(.alabaster)                // text color (custom defined)
                    .lineSpacing(0)                             // 100% line-height → no extra spacing
                    .kerning(0)                                 // letter-spacing: 0px
                    .frame(maxWidth: .infinity, alignment: .center) // horizontal centering
                    .fixedSize(horizontal: false, vertical: true)   // keep natural height


            }.padding(.bottom, 12)
            
            AnimatedSearchButton(iconName: "magnifyingglass")
            VStack{
                HStack{
                    Text("Available Devices")
                        .font(.custom("Poppins-Medium", size: 20))   // 500 weight = Medium
                        .foregroundColor(Color(hex: "#C9C4BD"))      // matches #C9C4BD
                        .multilineTextAlignment(.center)             // aligns text centrally
                        .lineSpacing(0)                              // 100% line height = no extra spacing
                        .kerning(0)// letter-spacing: 0px
                        .padding(.horizontal, 16)

                    Spacer()
                }
                                
                ScrollView(.vertical, showsIndicators: false) {
                    VStack(spacing: 12) {
                        // Separate Wi-Fi and BLE devices for ordered display
                        let wifiDevices = bonjourBrowser.discoveredWiFiDevices.filter { allowedNames.contains($0.name) }
                        
                        // BLE devices (scanned + connected)
                        let connected: [BLEDevice] = ble.connectedDevices.compactMap { (uuid, tuple) in
                            // Only include devices that are actually connected
                            guard tuple.peripheral.state == .connected else { return nil }
                            return BLEDevice(name: tuple.peripheral.name ?? "Unknown Device", uuid: uuid.uuidString, deviceType: .bluetooth)
                        }
                        let allBLEDevices = scannedDevices + connected
                        let mergedBLEById: [String: BLEDevice] = allBLEDevices.reduce(into: [:]) { dict, dev in
                            dict[dev.uuid] = dev
                        }
                        let bleDevices = Array(mergedBLEById.values).filter { allowedNames.contains($0.name) }
                        
                        // Combine with Wi-Fi devices first, then BLE devices
                        let orderedDevices = wifiDevices + bleDevices
                        ForEach(orderedDevices) { device in
                            // Show BLE devices only if Bluetooth is on, Wi-Fi devices always show if discovered
                            if (device.deviceType == .bluetooth && ble.isBluetoothOn) || device.deviceType == .wifi {
                                DevicesButton(
                                    deviceName: device.name,
                                    searchDeviceUUID: device.uuid,
                                    onConnect: { name, id in
                                        if device.deviceType == .bluetooth {
                                            BluetoothManager.shared.selectAndConnect(name: name, uuidString: id)
                                            self.selectedName = name
                                            self.selectedId = id
                                            // Clear previous list and fetch from FB04
                                            self.ssidNameArray = []
                                            BluetoothManager.shared.readWifiList { list in
                                                DispatchQueue.main.async {
                                                    self.ssidNameArray = list
                                                }
                                            }
                                            self.showAddWifi = true
                                        } else {
                                            // Handle Wi-Fi device connection - check TXT record
                                            print("📶 Connecting to Wi-Fi device: \(name) at IP: \(device.ipAddress ?? "unknown")")
                                            
                                            if let txtRecord = device.txtRecord {
                                                print("📦 TXT Record found: \(txtRecord)")
                                                
                                                if let channelCountStr = txtRecord["channelCount"],
                                                   let channelCount = Int(channelCountStr),
                                                   let channelMac = txtRecord["deviceId"] {
                                                    
                                                    print("✅ Found channelCount: \(channelCount), channelMac: \(channelMac)")
                                                    
                                                    if channelCount == 1 {
                                                        print("🎯 Opening PWM2LEDWifiView for single channel device")
                                                        self.selectedChannelMac = channelMac
                                                        self.isShowingPWM2LEDSheet = true
                                                    } else {
                                                        print("⚠️ Multi-channel device (channelCount: \(channelCount)), using default flow")
                                                        self.selectedName = name
                                                        self.selectedId = id
                                                        self.isShowingRGBDataSheet = true
                                                    }
                                                } else {
                                                    print("⚠️ Missing channelCount or deviceId in TXT record")
                                                    self.selectedName = name
                                                    self.selectedId = id
                                                    self.showAddWifi = true
                                                }
                                            } else {
                                                print("⚠️ No TXT record found, using default flow")
                                                self.selectedName = name
                                                self.selectedId = id
                                                self.showAddWifi = true
                                            }
                                        }
                                    },
                                    isConnected: {
                                        if device.deviceType == .bluetooth {
                                            return UUID(uuidString: device.uuid).map { 
                                                if let deviceInfo = ble.connectedDevices[$0] {
                                                    return deviceInfo.peripheral.state == .connected
                                                }
                                                return false
                                            } ?? false
                                        } else {
                                            // Wi-Fi devices are considered "available" rather than "connected"
                                            return false
                                        }
                                    }(),
                                    deviceType: device.deviceType,
                                    ipAddress: device.ipAddress
                                )
                                .padding(.horizontal, 16)
                            }
                        }
                    }
                }
                Spacer()
                if shouldShowContinue {
                    Button(action: {
                    }) {
                        Text("Continue")
                            .font(.headline)
                            .foregroundColor(.white)
                            .padding()
                            .background(Color.blue)
                            .cornerRadius(10)
                    }
                }

            }
        }
        .background(Color(hex: "#111214"))
//        .ignoresSafeArea(.all)
        .onAppear {
            // Start BLE scanning
            BluetoothManager.shared.startScanning { devices in
                let mapped = devices.map { BLEDevice(name: $0.name, uuid: $0.id, deviceType: .bluetooth) }
                DispatchQueue.main.async {
                    self.scannedDevices = mapped
                }
            }
            // Start Bonjour service discovery for Wi-Fi devices
            bonjourBrowser.startBrowsing()
        }
        .onDisappear {
            BluetoothManager.shared.stopScanning()
            bonjourBrowser.stopBrowsing()
        }
        .fullScreenCover(isPresented: $showAddWifi) {
//            DemoAddingWifiView(deviceName: selectedName ?? "", deviceId: selectedId ?? "")
            WifiList(deviceName: selectedName ?? "", deviceId: selectedId ?? "", wifiList: ssidNameArray)

        }

        .sheet(isPresented: $isShowingPWM2LEDSheet) {
            PWM2LEDWifiView(channelMac: selectedChannelMac)
            
        }
        .sheet(isPresented: $isShowingRGBDataSheet) {
            DataRGBWifiView(chennalMac: selectedChannelMac)
            
        }

    }
    
    private func debugDiscoveredDevices() {
        print("🔍 DEBUG: Total discovered Wi-Fi devices: \(bonjourBrowser.discoveredWiFiDevices.count)")
        for device in bonjourBrowser.discoveredWiFiDevices {
            print("🔍 DEBUG: Wi-Fi device - Name: '\(device.name)', UUID: '\(device.uuid)', IP: '\(device.ipAddress ?? "none")'")
        }
        let wifiDevices = bonjourBrowser.discoveredWiFiDevices.filter { allowedNames.contains($0.name) }
        print("🔍 DEBUG: Filtered Wi-Fi devices: \(wifiDevices.count)")
        print("🔍 DEBUG: Allowed names: \(allowedNames)")
    }
}

