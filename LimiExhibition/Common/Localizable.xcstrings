        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LED’i yapılandırmadan önce lütfen e-postanızı kontrol edip girin ve geçerli bir kullanıcı olduğunuzu doğrulayın."
          }
        },
        "ur" : {
