    "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini يتيح لك محادثة طبيعية مع أجهزتك — اطلب تعديلات للغرفة، توصيات مخصّصة، أو ملخصات يومية بكل سهولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini ermöglicht eine natürliche Kommunikation mit deinen Geräten — bitte um Raum­anpassungen, personalisierte Empfehlungen oder tägliche Kurzübersichten – ganz unkompliziert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini, cihazlarınızla doğal bir sohbet deneyimi sunar — oda ayarlarını isteyin, kişiselleştirilmiş öneriler alın veya günlük bilgilendirmeleri kolayca isteyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini enables natural conversation with your devices — ask for room adjustments, personalized recommendations, or daily briefings with ease."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini 可让您与设备进行自然对话——轻松请求房间调整、个性化推荐或每日简报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini 讓您與裝置進行自然對話—輕鬆要求房間調整、個人化推薦或每日簡報。"
          }
        }
      }
    },
