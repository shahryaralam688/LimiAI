    "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل كلمة مرور الواي فاي لربط جهازك بأمان. يتيح ذلك لـ Limi البقاء متصلاً، والمزامنة مع الأجهزة الأخرى، والاستجابة فورًا — داخل شبكتك الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib dein WLAN-Passwort ein, um dein Gerät sicher zu verbinden. Dadurch bleibt Limi verbunden, kann Geräte synchronisieren und sofort reagieren — alles innerhalb deines privaten Netzwerks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazınızı güvenli bir şekilde bağlamak için Wi-Fi şifrenizi girin. Bu, Limi’nin bağlı kalmasını, diğer cihazlarınızla senkronize olmasını ve anında yanıt vermesini sağlar — hepsi özel ağınız içinde."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Wi-Fi password to link your device securely. This allows Limi to stay connected, sync with your other devices, and respond instantly — all within your private network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入您的 Wi-Fi 密码以安全地连接设备。\n这将使 Limi 保持连接、与其他设备同步，并在您的私有网络中即时响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入您的 Wi-Fi 密碼以安全地連接您的裝置。\n這將使 **Limi** 保持連線，與您的其他裝置同步，並在您的私人網路內即時回應。\n"
          }
        }
      }
    },
