    "Please check and enter your email before configuring the LED, and verify that you are a valid user." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى التحقق وإدخال بريدك الإلكتروني قبل ضبط إضاءة LED، والتأكد من أنك مستخدم موثوق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte überprüfe und gib deine E-Mail ein, bevor du die LED konfigurierst, und bestätige, dass du ein gültiger Nutzer bist."
          }
        },
