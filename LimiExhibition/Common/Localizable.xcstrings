    "LIMI AI is your smart light management and automation assistant!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limi الذكاء الاصطناعي هو مساعدك الذكي لإدارة الإضاءة والأتمتة!"
