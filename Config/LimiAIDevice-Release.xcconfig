// LIMI AI Device — Release builds. Mirrors Limi-Release.xcconfig:
// production API is temporarily down (502), so point at dev. Restore
// https:/$()/api.limitless-lighting.co.uk/ before App Store release.
LIMI_API_BASE_URL = https:/$()/dev.api.limitless-lighting.co.uk/
LIBRARY_SEARCH_PATHS = /usr/lib/swift "$(DEVELOPER_DIR)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/$(PLATFORM_NAME)"
